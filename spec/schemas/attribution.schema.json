{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BTONGK/credence/main/spec/schemas/attribution.schema.json",
  "title": "Credence attribution",
  "description": "How credit for a claim is split. Shares sum to 1. Licensed CC BY 4.0.",
  "type": "object",
  "required": ["claim_id", "shares", "method"],
  "properties": {
    "claim_id": { "type": "string" },
    "method": { "type": "string", "examples": ["line_provenance", "line_provenance+direction", "event_authorship", "human_override:maya"] },
    "shares": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contributor", "share"],
        "properties": {
          "contributor": { "type": "string" },
          "share": { "type": "number", "minimum": 0, "maximum": 1 },
          "basis": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
